# SesKlon ayarları. Bu dosyayı .env adıyla kopyalayıp gerekeni değiştirin:
#   Linux/macOS:  cp .env.example .env        Windows:  copy .env.example .env
# .env dosyasını run.sh, run.ps1 ve docker compose okur. Boş bırakılan ya da # ile kapatılan değişken
# varsayılanını kullanır. .env git'e eklenmez (API anahtarı içerebilir; .gitignore'da).

# ---------------------------------------------------------------- güvenlik
# Doluysa tüm /api/* istekleri "X-API-Key: <anahtar>" başlığı ister (arayüzde ⚙ düğmesinden girilir).
# Sunucuyu internete ya da paylaşılan bir ağa açacaksanız mutlaka doldurun. Rastgele anahtar: openssl rand -hex 24
# Not: /files/... altındaki ses dosyaları anahtar istemez (adları tahmin edilemeyen rastgele kimliklerdir).
API_KEY=

# ---------------------------------------------------------------- model ve cihaz
# cuda | mps | cpu — boş = otomatik (NVIDIA GPU → cuda, Apple Silicon → mps, yoksa cpu).
DEVICE=
# 1 = model açılışta arka planda yüklenir, ilk üretim beklemez. 0 = ilk üretimde yüklenir (geliştirmede hızlı açılış).
PRELOAD=1
# Chatterbox Multilingual sürümü: v3 (önerilen) | v2
T3_MODEL=v3

# ---------------------------------------------------------------- sınırlar (gösterilen değerler varsayılandır)
# Tek istekte en fazla karakter.
# MAX_TEXT_CHARS=5000
# Yükleme sınırı (MB): referans kayıtları, ses→ses kaynakları, ses yedeği (içe aktarma) dosyaları.
# MAX_UPLOAD_MB=60
# Geçmişte tutulacak en fazla üretim; aşılınca en eskileri silinir (0 = sınırsız).
# MAX_OUTPUTS=500
# Metin, cümle sınırlarından en fazla bu uzunlukta parçalara bölünerek üretilir. Büyütmek kararlılığı azaltabilir.
# CHUNK_CHARS=170
# Referans kaydın kullanılan en uzun süresi (sn); daha uzun kayıtlardan konuşmanın en yoğun bölümü seçilir.
# MAX_REF_SECONDS=15

# ---------------------------------------------------------------- yollar (yalnızca Docker'sız çalıştırmada)
# Docker'da bu yollar imajda sabittir (/data birimi) ve buradan değiştirilemez.
# Sesler, üretimler, veritabanı (sesklon.db) ve okunuş sözlüğü (pronunciations.json). Varsayılan: backend/data
# Göreli yol run betiklerinde backend/ klasörüne göre çözülür; mutlak yol kullanın.
# DATA_DIR=/home/kullanici/sesklon-veri
# Derlenmiş arayüz klasörü; run betikleri kendisi ayarlar. Varsayılan: frontend/dist
# FRONTEND_DIST=
# Hugging Face model önbelleği (~2 GB). Varsayılan: ~/.cache/huggingface (Windows: %USERPROFILE%\.cache\huggingface)
# HF_HOME=

# ---------------------------------------------------------------- kurulum (yalnızca run.sh / run.ps1)
# PyTorch'un kurulacağı paket dizini. GPU'suz Linux'ta CUDA'sız ve birkaç GB küçük kurulum için:
# TORCH_INDEX=https://download.pytorch.org/whl/cpu
# Windows'ta boşsa ve NVIDIA GPU varsa https://download.pytorch.org/whl/cu124 kendiliğinden kullanılır.
# Docker'da bunun yerine build argümanı kullanılır (docker-compose.cpu.yml bunu yapar).
# TORCH_INDEX değiştiyse yeni yapının kurulması için .venv klasörünü silip betiği yeniden çalıştırmak en temizidir.
# TORCH_VERSION=2.6.0
